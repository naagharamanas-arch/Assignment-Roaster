# Database (docker-compose composes DATABASE_URL from these)
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=assignment_roaster
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/assignment_roaster

# "development" allows a placeholder SECRET_KEY. Any other value (docker-compose defaults to
# "production") refuses to start unless SECRET_KEY is random and 32+ chars.
ENVIRONMENT=development
# Comma-separated proxy IPs whose X-Forwarded-For header uvicorn should trust (your reverse proxy)
FORWARDED_ALLOW_IPS=127.0.0.1

# Auth (generate a real key with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# AI / GitHub
OPENAI_API_KEY=
OPENAI_MODEL=
GITHUB_TOKEN=

# Payments (post-MVP)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# URLs
APP_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000